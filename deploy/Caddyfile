# 리버스 프록시 (D-022, tech/07 4장). 인증서는 Caddy가 Let's Encrypt로 자동 발급·갱신한다.
# 값은 compose.prod.yml이 환경 변수로 넣는다: API_HOST, ADMIN_HOST, ACME_EMAIL, ADMIN_ALLOW_CIDRS(공백 구분)
{
	email {$ACME_EMAIL}
	# 앞단 프록시가 없다 — X-Forwarded-For를 믿지 않고 실제 접속 IP(remote_ip)로 판단한다
}

# 관리자 호스트와 SSH 터널이 같이 쓰는 경로: /api/admin/*는 API로, 나머지는 관리자 웹으로.
# 같은 출처라 세션 쿠키(SameSite=Strict, path /api/admin)와 CSRF 헤더가 그대로 동작한다
(admin_routes) {
	header {
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
	handle /api/admin/* {
		reverse_proxy api:3000
	}
	handle {
		reverse_proxy admin:3100
	}
}

{$API_HOST} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	# 관리자 API는 앱 호스트로 열지 않는다
	@admin path /api/admin /api/admin/*
	respond @admin 404
	reverse_proxy api:3000
}

{$ADMIN_HOST} {
	# 허용 IP 밖이면 403. ADMIN_ALLOW_CIDRS가 비면 compose가 아무도 아닌 주소만 넣어 전부 차단된다
	# handle 블록은 적힌 순서로 하나만 실행된다 — 차단을 관리자 경로(admin_routes)보다 먼저 둔다
	# (respond 지시어는 handle 뒤로 정렬돼 차단이 건너뛰어지므로 쓰지 않는다)
	@denied not remote_ip {$ADMIN_ALLOW_CIDRS}
	handle @denied {
		respond 403
	}
	header Strict-Transport-Security "max-age=31536000"
	import admin_routes
}

# SSH 터널 전용 (compose가 서버 루프백 127.0.0.1:8081에만 연다).
# ssh -L 8081:127.0.0.1:8081 서버 → 브라우저 http://localhost:8081 (tech/07 4장)
http://:8081 {
	import admin_routes
}
