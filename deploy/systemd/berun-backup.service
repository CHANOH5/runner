# 매일 DB 백업 (tech/07 6장). 설치: sudo cp deploy/systemd/berun-backup.* /etc/systemd/system/ && sudo systemctl enable --now berun-backup.timer
# 결과 확인: journalctl -u berun-backup.service
[Unit]
Description=BeRun daily pg_dump to S3
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
ExecStart=/opt/berun/deploy/scripts/backup.sh
