# compose.prod.yml 치환 값 (tech/07 3장). 서버의 /opt/berun/deploy/.env로 복사해 채운다: cp .env.example .env && chmod 600 .env
# 이 파일과 .env.app은 서버에만 두고 커밋하지 않는다. 비밀번호는 비밀번호 관리자에도 보관한다.

# 배포하는 이미지. 태그는 scripts/deploy.sh가 성공한 배포마다 갱신한다 (git 커밋 sha)
SERVER_IMAGE=<계정번호>.dkr.ecr.ap-northeast-2.amazonaws.com/berun-single-server
ADMIN_IMAGE=<계정번호>.dkr.ecr.ap-northeast-2.amazonaws.com/berun-single-admin
IMAGE_TAG=

# 도메인 [미정 PRD Q-12]. DNS A 레코드가 서버 고정 IP를 가리켜야 인증서가 발급된다. AAAA(IPv6)는 만들지 않는다 (tech/07 4장)
API_HOST=api.berun.app
ADMIN_HOST=admin.berun.app
# Let's Encrypt 계정(인증서 만료 알림) 이메일
ACME_EMAIL=

# 관리자 호스트 허용 IP (공백 구분 CIDR, 예: "203.0.113.10/32 198.51.100.0/24").
# 비워 두면 관리자 호스트는 전부 차단되고 SSH 터널로만 들어간다 (권장 기본값)
ADMIN_ALLOW_CIDRS=

# 내부 DB·Redis 비밀번호. URL에 그대로 들어가므로 영숫자만: openssl rand -hex 24
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# 매일 백업(scripts/backup.sh)을 올릴 S3 버킷 — CDK 출력 BackupBucketName
BACKUP_BUCKET=
