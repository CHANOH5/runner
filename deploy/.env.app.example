# API·워커가 읽는 서버 비밀값 (tech/07 3장). 서버의 /opt/berun/deploy/.env.app로 복사해 채운다: chmod 600 .env.app
# DATABASE_URL·REDIS_URL·NODE_ENV는 compose.prod.yml이 넣는다 — 여기 적지 않는다.
LOG_LEVEL=info

# access token ES256 키 쌍 (PEM, 줄바꿈은 \n). 로컬에서 만들어 붙인다 (tech/07 3장 5단계)
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=

# 저장 암호화 데이터 키: KMS token 키로 감싼 CiphertextBlob(base64). 서버는 시작할 때 인스턴스 역할로 KMS Decrypt만 한다.
# 운영(production)은 평문 TOKEN_ENC_KEY를 거부한다
TOKEN_ENC_KEY_KMS_CIPHERTEXT=
TOKEN_ENC_KMS_KEY_ID=alias/berun-single-token

# 소셜 로그인·연결 해제 (각 개발자 콘솔에서 발급)
KAKAO_APP_ID=
KAKAO_ADMIN_KEY=
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# 푸시. 운영 기본은 실제 발송 (PUSH_DRY_RUN·UNLINK_DRY_RUN을 비우면 production에서 false)
EXPO_ACCESS_TOKEN=
EXPO_PUSH_RATE_PER_SEC=300
