# 로컬 개발용 예시. 복사해서 .env로 쓴다 (cp .env.example .env). .env는 커밋하지 않는다.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug

# docker compose 기본값 (docker-compose.yml)
DATABASE_URL=postgres://berun:berun@localhost:55432/berun
TEST_DATABASE_URL=postgres://berun:berun@localhost:55432/berun_test
REDIS_URL=redis://localhost:56379

# access token 검증용 ES256 공개키 (PEM, 줄바꿈은 \n). 비우면 인증이 필요한 API는 모두 401.
# 로컬 키 만들기: pnpm --filter @berun/server dev:keys
JWT_PUBLIC_KEY=
# access token 발급 개인키. 서버(로그인·가입·토큰 회전)와 dev:token 스크립트가 쓴다. 운영은 Secrets Manager.
JWT_PRIVATE_KEY=

# 저장 암호화 키 (Apple refresh token 등). base64 32바이트. 로컬: openssl rand -base64 32
TOKEN_ENC_KEY=

# 소셜 로그인. 비워 두면 해당 provider 로그인이 500 (통합 테스트는 가짜 verifier를 쓴다)
# 실제 값은 각 개발자 콘솔에서 발급하고 커밋하지 않는다.
KAKAO_APP_ID=
# 쉼표 구분 (iOS, Android, 웹 클라이언트 id)
GOOGLE_CLIENT_IDS=
# Sign in with Apple: bundle id, 팀 id, 키 id, 키(PEM, 줄바꿈은 \n)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# (워커, 다음 작업) 카카오 연결 끊기용 어드민 키
KAKAO_ADMIN_KEY=
