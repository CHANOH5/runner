{
  "expo": {
    "name": "BeRun",
    "slug": "berun",
    "scheme": "berun",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.berun.dev",
      "supportsTablet": false,
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["nmap", "kakaomap"]
      }
    },
    "android": {
      "package": "app.berun.dev"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiBaseUrl": null
    }
  }
}
