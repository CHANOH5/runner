{
  "name": "@berun/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source --env-file-if-exists=../.env src/server.ts",
    "start": "node --env-file-if-exists=../.env dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=source --env-file-if-exists=../.env src/db/migrate.ts",
    "db:seed": "tsx --conditions=source --env-file-if-exists=../.env src/db/seed.ts",
    "dev:keys": "tsx scripts/dev-keys.ts",
    "dev:token": "tsx --conditions=source --env-file-if-exists=../.env scripts/dev-token.ts",
    "worker": "tsx watch --conditions=source --env-file-if-exists=../.env src/worker/index.ts",
    "start:worker": "node --env-file-if-exists=../.env dist/worker/index.js",
    "notifications:recalc": "tsx --conditions=source --env-file-if-exists=../.env scripts/recalc-schedules.ts",
    "dev:admin-totp": "tsx --conditions=source scripts/dev-admin-totp.ts",
    "admin:create-owner": "tsx --conditions=source --env-file-if-exists=../.env src/cli/create-owner.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1157.0",
    "@berun/shared": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "@node-rs/argon2": "^2.2.2",
    "bullmq": "^5.81.5",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.13",
    "pino": "^9.14.0",
    "postgres": "^3.4.9",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  }
}
